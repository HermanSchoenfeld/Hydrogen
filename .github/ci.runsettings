<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <NUnit>
    <!-- Keep discovery and every partition deterministic, including [Random] cases. -->
    <RandomSeed>1234567</RandomSeed>
    <!-- Partition filters must not opt explicit tests into CI or fall back to running everything. -->
    <ExplicitMode>None</ExplicitMode>
    <AssemblySelectLimit>2147483647</AssemblySelectLimit>
    <ConsoleOut>0</ConsoleOut>
    <Verbosity>-1</Verbosity>
  </NUnit>
</RunSettings>
